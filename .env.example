# ============================================================
# 环境变量配置 — 复制为 .env 并填入实际值
# ============================================================

# ===== 1. 模型提供商切换（必选其一） =====
# 已接入：siliconflow（默认） | deepseek | zhipu | openai | openrouter
# 环境变量配置完整即可直接使用；设置界面是可选的会话级覆盖
AGNO_MODEL_PROVIDER=siliconflow

# ===== 2. DeepSeek 原生 API（provider=deepseek 时必填） =====
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL_ID=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== 3. SiliconFlow 配置（provider=siliconflow 时必填） =====
SILICONFLOW_API_KEY=sk-your-siliconflow-key
# SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3.1-Terminus

# ===== 4. 智谱 GLM（provider=zhipu 时必填；OpenAI 兼容端点） =====
# ZHIPU_API_KEY=your-zhipu-key
# ZHIPU_MODEL=glm-4.6

# ===== 5. OpenAI（provider=openai 时必填） =====
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o

# ===== 6. OpenRouter 聚合入口（provider=openrouter 时必填） =====
# OPENROUTER_API_KEY=sk-or-your-openrouter-key
# OPENROUTER_MODEL=openai/gpt-4o-mini

# ===== 7. Embedding API Key（语义检索，无论聊天 provider 都走 SiliconFlow Embedding） =====
# 注意：即使聊天使用其他提供商，embedding 仍需要 SILICONFLOW_API_KEY

# ===== 8. 通用密钥兜底（可选） =====
# 当前家专属密钥未设置时的最终回退
# FALLBACK_API_KEY=xxx
