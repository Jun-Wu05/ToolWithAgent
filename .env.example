# 环境变量配置示例
# 复制此文件为 .env 并填入你的配置

# ===== SiliconFlow API ====
# 主 API Key（必填）
SILICONFLOW_API_KEY=xxx

# 备用 API Key（主 Key 不可用时的 fallback）
# FALLBACK_API_KEY=xxx

# ===== 模型配置 =====
# 主模型 (默认: deepseek-ai/DeepSeek-V3.1-Terminus)
# SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3.1-Terminus

# 备用模型 ID（fallback 时使用，默认: Qwen/Qwen2.5-7B-Instruct）
# FALLBACK_MODEL_ID=Qwen/Qwen2.5-7B-Instruct

# 是否启用 fallback（默认: true）
# FALLBACK_ENABLED=true

# ===== Agno 调试配置 (生产环境应关闭) =====
# 调试模式（默认: false）
# AGNO_DEBUG_MODE=false

# 展示成员响应（默认: false）
# AGNO_SHOW_MEMBERS=false