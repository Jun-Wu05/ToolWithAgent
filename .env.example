# ============================================================
# 环境变量配置 — 复制为 .env 并填入实际值
# ============================================================

# ===== 1. 模型提供商切换（必选其一） =====
# AGNO_MODEL_PROVIDER: "siliconflow"（默认） | "deepseek"（原生）
AGNO_MODEL_PROVIDER=siliconflow

# ===== 2. DeepSeek 原生 API（provider=deepseek 时必填） =====
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_MODEL_ID=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== 3. SiliconFlow 配置（provider=siliconflow 时必填） =====
SILICONFLOW_API_KEY=sk-your-siliconflow-key
# SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3.1-Terminus

# ===== 4. Embedding API Key（语义检索，无论 provider 都走 SiliconFlow Embedding） =====
# 注意：即使 AGNO_MODEL_PROVIDER=deepseek，embedding 仍需要 SILICONFLOW_API_KEY

# ===== 5. 备用模型（可选） =====
# FALLBACK_ENABLED=true
# FALLBACK_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# FALLBACK_API_KEY=xxx

# ===== 6. 调试开关（可选） =====
# AGNO_DEBUG_MODE=true
# AGNO_SHOW_MEMBERS=true