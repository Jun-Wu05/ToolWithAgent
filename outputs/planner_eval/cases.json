{
  "description": "planner 语义遵循度评测集：12 操作 x2 + 消歧难例 + 复合 + 澄清。宽松匹配=decision+步骤类型序列+声明的关键参数。",
  "cases": [
    {"id": "log_parse_basic", "category": "basic", "user_text": "识别日志类型", "facts": {"has_logs": true},
     "expect": {"decision": "execute", "steps": [{"type": "log_parse"}]}},
    {"id": "log_parse_explicit_field", "category": "basic", "user_text": "把 category 字段作为日志类型", "facts": {"has_logs": true},
     "expect": {"decision": "execute", "steps": [{"type": "log_parse", "feature_field": "category"}]}},
    {"id": "field_mapping_basic", "category": "basic", "user_text": "做字段映射", "facts": {"has_logs": true, "available_fields": ["event_type", "level"]},
     "expect": {"decision": "execute", "steps": [{"type": "field_mapping"}]}},
    {"id": "field_mapping_variant", "category": "basic", "user_text": "把原始字段映射到标准字段", "facts": {"available_fields": ["src_ip"]},
     "expect": {"decision": "execute", "steps": [{"type": "field_mapping"}]}},
    {"id": "enum_extract_basic", "category": "basic", "user_text": "提取 event_type 字段的枚举值", "facts": {"has_logs": true},
     "expect": {"decision": "execute", "steps": [{"type": "enum_extract", "target_field": "event_type"}]}},
    {"id": "enum_extract_variant", "category": "basic", "user_text": "帮我提取出 level 字段的枚举值", "facts": {"has_logs": true},
     "expect": {"decision": "execute", "steps": [{"type": "enum_extract", "target_field": "level"}]}},
    {"id": "threat_mapping_values", "category": "basic", "user_text": "把 SQL注入 和 暴力破解 做威胁类型映射", "facts": {},
     "expect": {"decision": "execute", "steps": [{"type": "threat_mapping", "source_ref": "user.values"}]}},
    {"id": "threat_mapping_variant", "category": "basic", "user_text": "这些值做威胁类型映射：钓鱼邮件、垃圾邮件", "facts": {},
     "expect": {"decision": "execute", "steps": [{"type": "threat_mapping", "source_ref": "user.values"}]}},
    {"id": "fill_enum_all", "category": "basic", "user_text": "把枚举映射表填充回配置", "facts": {"has_decoded_config": true, "has_mapped_sub_rules": true, "available_config_refs": ["session.decoded_config", "session.mapped_sub_rules"], "enum_mapping_row_count": 5, "enum_mapping_target_fields": ["event_type"]},
     "expect": {"decision": "execute", "steps": [{"type": "fill", "fill_kind": "enum"}]}},
    {"id": "fill_enum_named", "category": "basic", "user_text": "把枚举映射表填充到 event_type 字段", "facts": {"has_mapped_sub_rules": true, "available_config_refs": ["session.mapped_sub_rules"], "enum_mapping_row_count": 3, "enum_mapping_target_fields": ["event_type"]},
     "expect": {"decision": "execute", "steps": [{"type": "fill", "fill_kind": "enum", "target_fields": ["event_type"]}]}},
    {"id": "remove_mapping_basic", "category": "basic", "user_text": "取消 event_type 的值映射", "facts": {"has_mapped_sub_rules": true, "available_config_refs": ["session.mapped_sub_rules"]},
     "expect": {"decision": "execute", "steps": [{"type": "remove_mapping", "target_fields": ["event_type"]}]}},
    {"id": "export_basic", "category": "basic", "user_text": "导出当前配置", "facts": {"has_mapped_sub_rules": true, "available_config_refs": ["session.mapped_sub_rules"]},
     "expect": {"decision": "execute", "steps": [{"type": "export", "source_ref": "session.mapped_sub_rules"}]}},
    {"id": "export_variant", "category": "basic", "user_text": "下载子规则", "facts": {"has_log_classification": true},
     "expect": {"decision": "execute", "steps": [{"type": "export"}]}},
    {"id": "add_fields_fixed", "category": "basic", "user_text": "添加字段 主机ip，值为 1.1.1.1", "facts": {"has_decoded_config": true, "available_config_refs": ["session.decoded_config"]},
     "expect": {"decision": "execute", "steps": [{"type": "add_fields", "field_name": "主机ip", "field_value": "1.1.1.1"}]}},
    {"id": "add_fields_reference", "category": "basic", "user_text": "新增字段 请求头，值引用 reqheader", "facts": {"has_mapped_sub_rules": true, "available_config_refs": ["session.mapped_sub_rules"]},
     "expect": {"decision": "execute", "steps": [{"type": "add_fields", "field_name": "请求头", "field_value": "%{reqheader}", "value_type": "reference"}]}},
    {"id": "delete_fields_multi", "category": "basic", "user_text": "删除字段 a 和 b", "facts": {"has_mapped_sub_rules": true, "available_config_refs": ["session.mapped_sub_rules"]},
     "expect": {"decision": "execute", "steps": [{"type": "delete_fields", "fields": ["a", "b"]}]}},
    {"id": "delete_fields_variant", "category": "basic", "user_text": "把 server 字段去掉", "facts": {"has_decoded_config": true, "available_config_refs": ["session.decoded_config"]},
     "expect": {"decision": "execute", "steps": [{"type": "delete_fields", "fields": ["server"]}]}},
    {"id": "merge_fields_sep", "category": "basic", "user_text": "把字段 a 和 b 合并成 d，分隔符 -", "facts": {"has_decoded_config": true, "available_config_refs": ["session.decoded_config"]},
     "expect": {"decision": "execute", "steps": [{"type": "merge_fields", "source_fields": ["a", "b"], "target_field": "d", "sep": "-"}]}},
    {"id": "merge_fields_variant", "category": "basic", "user_text": "将 src 和 dst 合并为地址", "facts": {"has_mapped_sub_rules": true, "available_config_refs": ["session.mapped_sub_rules"]},
     "expect": {"decision": "execute", "steps": [{"type": "merge_fields", "source_fields": ["src", "dst"], "target_field": "地址"}]}},
    {"id": "decode_fields_basic", "category": "basic", "user_text": "解码 req_header 和 req_body", "facts": {"has_decoded_config": true, "available_config_refs": ["session.decoded_config"]},
     "expect": {"decision": "execute", "steps": [{"type": "decode_fields", "fields": ["req_header", "req_body"]}]}},
    {"id": "decode_fields_variant", "category": "basic", "user_text": "对 payload 字段做 base64 解码", "facts": {"has_mapped_sub_rules": true, "available_config_refs": ["session.mapped_sub_rules"]},
     "expect": {"decision": "execute", "steps": [{"type": "decode_fields", "fields": ["payload"]}]}},
    {"id": "regex_extract_original_log", "category": "basic", "user_text": "把原始日志里的 client 提取出来", "facts": {"has_decoded_config": true, "available_config_refs": ["session.decoded_config"]},
     "expect": {"decision": "execute", "steps": [{"type": "regex_extract", "source_field": "original_log"}]}},
    {"id": "regex_extract_req_header", "category": "basic", "user_text": "把请求头里的 Referer 提取出来", "facts": {"has_mapped_sub_rules": true, "available_config_refs": ["session.mapped_sub_rules"]},
     "expect": {"decision": "execute", "steps": [{"type": "regex_extract", "source_field": "req_header"}]}},
    {"id": "add_event_name_bound", "category": "basic", "user_text": "添加字段 事件名称，值为 网络攻击", "facts": {"has_mapped_sub_rules": true, "available_config_refs": ["session.mapped_sub_rules"]},
     "expect": {"decision": "execute", "steps": [{"type": "add_fields", "field_name": "事件名称", "field_value": "网络攻击"}]}},
    {"id": "disambig_delete_not_remove", "category": "disambig", "user_text": "删除 event_type 字段", "facts": {"has_mapped_sub_rules": true, "available_config_refs": ["session.mapped_sub_rules"]},
     "expect": {"decision": "execute", "steps": [{"type": "delete_fields", "fields": ["event_type"]}]}},
    {"id": "disambig_enum_not_regex", "category": "disambig", "user_text": "提取 event_type 的枚举值", "facts": {"has_logs": true},
     "expect": {"decision": "execute", "steps": [{"type": "enum_extract", "target_field": "event_type"}]}},
    {"id": "disambig_fixed_field_mapping", "category": "disambig", "user_text": "把 attack_name 字段映射成事件名称", "facts": {"has_logs": true, "available_fields": ["attack_name"]},
     "expect": {"decision": "clarification"}},
    {"id": "disambig_followup_single_word", "category": "disambig", "user_text": "Type",
     "history": [{"role": "assistant", "content": "日志类型提取未执行：日志中不存在字段「Type」。日志中可用的字段：type、category、level。请回复要作为日志类型的字段名，或直接说\"日志类型提取\"由系统自动探测。"}],
     "facts": {"has_logs": true},
     "expect": {"decision": "execute", "steps": [{"type": "log_parse"}]}},
    {"id": "disambig_fill_event_level", "category": "disambig", "user_text": "把事件级别填充为提醒", "facts": {"has_mapped_sub_rules": true, "available_config_refs": ["session.mapped_sub_rules"], "enum_mapping_row_count": 2, "enum_mapping_target_fields": ["事件级别"]},
     "expect": {"decision": "clarification"}},
    {"id": "compound_enum_threat_fill", "category": "compound", "user_text": "提取 event_type3 的枚举值，再做威胁映射并填充回 event_type3", "facts": {"has_logs": true, "has_mapped_sub_rules": true, "available_config_refs": ["session.mapped_sub_rules"]},
     "expect": {"decision": "execute", "steps": [{"type": "enum_extract", "target_field": "event_type3"}, {"type": "threat_mapping", "source_ref": "step:enum-1"}, {"type": "fill", "fill_kind": "threat"}]}},
    {"id": "compound_decode_then_extract", "category": "compound", "user_text": "先解码 req_header，再把请求头里的 Referer 提取出来", "facts": {"has_decoded_config": true, "available_config_refs": ["session.decoded_config"]},
     "expect": {"decision": "execute", "steps": [{"type": "decode_fields", "fields": ["req_header"]}, {"type": "regex_extract", "source_field": "req_header"}]}},
    {"id": "clarify_no_logs", "category": "clarify", "user_text": "日志类型提取", "facts": {},
     "expect": {"decision": "clarification"}},
    {"id": "clarify_no_config_add", "category": "clarify", "user_text": "添加字段 主机ip，值为 1.1.1.1", "facts": {},
     "expect": {"decision": "clarification"}},
    {"id": "targeting_add_fields", "category": "targeting", "user_text": "给 暴力破解_kv_子规则 添加字段 备注，值为 重点", "facts": {"has_mapped_sub_rules": true, "available_config_refs": ["session.mapped_sub_rules"], "mapped_sub_rule_names": ["暴力破解_kv_子规则", "用户登录_json_子规则"]},
     "expect": {"decision": "execute", "steps": [{"type": "add_fields", "field_name": "备注", "field_value": "重点", "target_rule_names": ["暴力破解_kv_子规则"]}]}},
    {"id": "targeting_group_delete", "category": "targeting", "user_text": "把所有威胁子规则里的 临时字段 都删掉", "facts": {"has_mapped_sub_rules": true, "available_config_refs": ["session.mapped_sub_rules"], "mapped_sub_rule_names": ["暴力破解_kv_子规则", "用户登录_json_子规则"]},
     "expect": {"decision": "execute", "steps": [{"type": "delete_fields", "fields": ["临时字段"], "rule_group": "threat"}]}},
    {"id": "targeting_unknown_rule", "category": "targeting", "user_text": "给 不存在的规则 添加字段 备注，值为 重点", "facts": {"has_mapped_sub_rules": true, "available_config_refs": ["session.mapped_sub_rules"], "mapped_sub_rule_names": ["暴力破解_kv_子规则"]},
     "expect": {"decision": "clarification"}},
    {"id": "targeting_skip_existing", "category": "targeting", "user_text": "给所有子规则添加字段 标记，值为 1，已经有的跳过", "facts": {"has_mapped_sub_rules": true, "available_config_refs": ["session.mapped_sub_rules"], "mapped_sub_rule_names": ["暴力破解_kv_子规则"]},
     "expect": {"decision": "execute", "steps": [{"type": "add_fields", "field_name": "标记", "field_value": "1", "skip_existing": true}]}},
    {"id": "vocab_add_merge_single_op", "category": "vocab", "user_text": "添加响应内容字段，合并HTTP请求头和HTTP请求体", "facts": {"has_mapped_sub_rules": true, "available_config_refs": ["session.mapped_sub_rules"], "available_fields": ["req_head", "req_body", "src_ip"]},
     "expect": {"decision": "execute", "steps": [{"type": "merge_fields", "source_fields": ["HTTP请求头", "HTTP请求体"], "target_field": "响应内容"}]}},
    {"id": "vocab_verbatim_target_with_history", "category": "vocab", "user_text": "添加响应内容1字段，合并req_body和req_method",
     "history": [{"role": "user", "content": "添加响应内容字段，合并HTTP请求头和HTTP请求体"}, {"role": "assistant", "content": "计划 plan-add-merge 执行结果：merge-1 失败：源字段不存在"}],
     "facts": {"has_mapped_sub_rules": true, "available_config_refs": ["session.mapped_sub_rules"], "available_fields": ["req_body", "req_method"]},
     "expect": {"decision": "execute", "steps": [{"type": "merge_fields", "source_fields": ["req_body", "req_method"], "target_field": "响应内容1"}]}},
    {"id": "vocab_add_extract_single_op", "category": "vocab", "user_text": "添加 Referer 字段，把请求头里的 Referer 提取出来", "facts": {"has_decoded_config": true, "available_config_refs": ["session.decoded_config"]},
     "expect": {"decision": "execute", "steps": [{"type": "regex_extract", "source_field": "req_header", "description": "Referer", "new_field": "Referer"}]}}
  ]
}
